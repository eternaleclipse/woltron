{
  "name": "@woltron/server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Woltron local server: REST API, SSE, scheduler, ordering engine and LLM fetch.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@woltron/shared": "*",
    "@woltron/wolt": "*",
    "croner": "^10.0.1",
    "hono": "^4.13.12",
    "nanoid": "^6.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
